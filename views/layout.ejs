<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <% if(settings.website_title && settings.website_title.trim() !=='' ){ %>
        <title>
            <%= settings.website_title %>
        </title>
        <% }else{ %>
            <title>News</title>
            <% } %>

                <!-- Bootstrap -->
                <link href="/css/bootstrap.min.css" rel="stylesheet">
                <!-- Font Awesome Icon -->
                <link rel="stylesheet" href="/css/font-awesome.css">
                <!-- Custom stlylesheet -->
                <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div id="header-admin" class="bg-primary border-bottom shadow-sm">
    <div class="container">
        <div class="row align-items-center py-3">

            <!-- LOGO -->
            <div class="col">
                <% if(settings.website_logo && settings.website_logo.trim() !== '') { %>

                    <a href="/" class="d-inline-block">
                        <img 
                            src="/uploads/<%= settings.website_logo %>" 
                            alt="Logo"
                            class="img-fluid"
                            style="max-height: 55px;"
                        >
                    </a>

                <% } else { %>

                    <a href="/" class="d-inline-block">
                        <img 
                            src="/images/news.jpg" 
                            alt="Logo"
                            class="img-fluid"
                            style="max-height: 55px;"
                        >
                    </a>

                <% } %>
            </div>

            <!-- LOGIN -->
            <div class="col-auto ">
                <a href="/admin" 
                   class="btn text-white  px-4 py-2 rounded-pill fw-semibold">

                    <i class="fa text-white fa-sign-in me-2"></i>
                    Login

                </a>
            </div>

        </div>
    </div>
</div>
    <!-- /HEADER -->
    <!-- Menu Bar -->
    <div id="menu-bar">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <ul class='menu'>
                        <li><a href='/'>Home</a></li>
                        <% categories.forEach(item=> {%>
                            <li><a href='/category/<%= item.slug %>'>
                                    <%= item.name %>
                                </a></li>
                            <% }); %>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <!-- /Menu Bar -->

    <div id="main-content">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <%- body %>
                </div>
                <!-- sidebar -->
                <%- include('partials/sidebar') %>
                    <!-- /sidebar -->
            </div>
        </div>
    </div>
    <div id="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <% if(settings.footer_description && settings.footer_description.trim() !=='' ){ %>
                        <span>
                            <%= settings.footer_description %>
                        </span>
                        <% }else{ %>

                            <% } %>
                </div>
            </div>
        </div>
    </div>
</body>

</html>